# Appended to the board debug.config by build_liteos_m.sh — enables the
# Lite Memory Sanitizer (shadow-memory heap checker) plus strict per-byte
# checks. Depends on DEBUG_VERSION + KERNEL_BACKTRACE (already default-on in
# the qemu_cm55_mini_system_demo board config).
LOSCFG_KERNEL_LMS=y
LOSCFG_LMS_CHECK_STRICT=y
