diff --git a/arm_mps3_an547/liteos_m/config.gni b/arm_mps3_an547/liteos_m/config.gni
index e6a716c..50e141e 100644
--- a/arm_mps3_an547/liteos_m/config.gni
+++ b/arm_mps3_an547/liteos_m/config.gni
@@ -44,6 +44,14 @@ board_opt_flags = []
 
 # Board related common compile flags.
 board_cflags = [
+  # LMS instrumentation: every kernel C file gets ASAN-style shadow checks,
+  # backed by LiteOS-M's built-in LMS runtime (__asan_storeN etc.).
+  "-O0",
+  "-Wno-error=implicit-function-declaration",
+  "-Wno-error=implicit-int",
+  "-Wno-error=int-conversion",
+  "-Wno-error=incompatible-pointer-types",
+
   "-Wall",
   "-mcpu=cortex-m55",
   "-mfloat-abi=hard",
@@ -69,7 +77,12 @@ board_asmflags += board_opt_flags
 
 board_cxx_flags = board_cflags
 
-board_ld_flags = []
+board_ld_flags = [
+  # gcc 15 libgcc unwind-arm.o references the EABI exception index symbols
+  # that the LiteOS-M linker script does not define (gcc 10 didn't need them).
+  "-Wl,--defsym=__exidx_start=0",
+  "-Wl,--defsym=__exidx_end=0",
+]
 
 # Newlib adapt.
 board_ld_flags += [
diff --git a/arm_mps3_an547/liteos_m/board/BUILD.gn b/arm_mps3_an547/liteos_m/board/BUILD.gn
index 729e9f1..6c3e717 100644
