+/*
+ * 5.10.y stable renamed addr_has_shadow -> addr_has_metadata but the callers
+ * in mm/kasan/*.c still use the old name; restore a compat alias so the
+ * KASAN build works on the OpenHarmony 5.10.210 tree.
+ */
+#ifndef addr_has_shadow
+static inline bool addr_has_shadow(const void *addr)
+{
+	return addr_has_metadata(addr);
+}
