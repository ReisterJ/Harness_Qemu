# Copy to `.env` and fill in your provider key(s). The pipeline loads `.env`
# automatically at CLI startup (no manual export). Lines: KEY=VALUE, `#`
# comments allowed, quotes optional. Already-set env vars take precedence.
#
#   cp .env.example .env   # then edit .env

# DeepSeek (opencode backend for `--model deepseek/<model>`)
DEEPSEEK_API_KEY=

# Optional: default model so you can omit --model
# VULN_PIPELINE_MODEL=deepseek/deepseek-v4-flash

# Optional: alternate .env path (default: repo root .env, then cwd .env)
# VULN_PIPELINE_ENV_FILE=/path/to/other.env
