.venv/
uv.lock
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
results/

# Local editor settings
.vscode/

# Downloaded source trees and local experiment targets. These are rebuilt by
# the target workflow and should not be committed to the harness repository.
targets/*/source/
targets/curl-cve-2023-38039/
targets/curl-socks5-overflow/
targets/ghostscript-type2-51089/
targets/libxml2/
targets/linux-v7-2/

# Large generated mruby/arvo SymCC experiment artifacts; keep the audit document
# and source changes versioned, but do not commit raw transcripts/containers.
/results/experiments/mruby-env-write-barrier/symcc-mruby-20260920/
build/
dist/

# Documentation is organized under docs/build/; keep it versioned even though
# generated build artifacts elsewhere are ignored.
!docs/build/
!docs/build/**

# Local secrets — keep provider keys out of git
.env
.codex

# Skill checkpoint state (scratch, per-run)
.threat-model-state/
.triage-state/
.patch-state/
.dnr-hunt-state/
.dnr-respond-state/
VULN-FINDINGS.md
VULN-FINDINGS.json
TRIAGE.md
TRIAGE.json
PATCHES/
PATCHES.md
PATCHES.json
INCIDENTS.json
INCIDENT_REPORT.md
RESPONSE.md
RESPONSE-*.md

# ...but DO track the checked-in example outputs (captured skill runs that
# ship with the repo). Negation must follow the patterns above.
!targets/*/example_skill_runs/**

# dnrcanary (dnr target) generated artifacts
targets/dnrcanary/logs/
targets/dnrcanary/app/dnrcanary.db
targets/libpng/
armgcc.tar.gz
